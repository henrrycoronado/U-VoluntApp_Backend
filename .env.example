# Base de datos
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=DatabaseName;Username=UserName;Password=Password

# JWT
JWT_SECRET=dev_secret_local_minimo_32_caracteres
JWT_ISSUER=U_VoluntApp_Backend.Src
JWT_AUDIENCE=UVoluntapp.Client
JWT_EXPIRY_MINUTES=60

# Supabase (solo Storage de archivos, requiere Service Role Key para bypass de RLS)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# SuperUsuario del sistema (minimo 8 caracteres, al menos 1 digito)
SUPERUSER_EMAIL=admin@tu-app.com
SUPERUSER_PASSWORD=Admin1234

CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.app.example.com