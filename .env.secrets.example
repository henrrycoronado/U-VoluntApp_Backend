# ==============================================================================
# SECRETOS PARA GITHUB ACTIONS (PIPELINE MASTER)
# ==============================================================================
# Este archivo documenta los nombres de los secretos que DEBES crear en 
# GitHub (Settings > Secrets and variables > Actions) para que el pipeline 
# de master (pipeline-master.yml) funcione correctamente y despliegue en K3s.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KUBERNETES (Despliegue)
# ------------------------------------------------------------------------------
# Contenido completo de tu archivo ~/.kube/config para que GH Actions se conecte al clúster.
KUBECONFIG_CONTENT="apiVersion: v1\nclusters:\n- cluster:..."

# ------------------------------------------------------------------------------
# 2. BACKEND API (Obligatorios)
# ------------------------------------------------------------------------------
# Cadena de conexión principal. 
DB_CONNECTION_STRING="Host=ep-mute-cloud-123456.us-east-2.aws.neon.tech;Port=5432;Database=uvoluntapp_db;Username=admin;Password=secret"

# Seguridad y JWT
JWT_SECRET="s3cr3t_k3y_muy_larga_y_s3gura_123!"

# Credenciales de Supabase (Storage)
STORAGE_URL="https://tu-proyecto.supabase.co"
STORAGE_SERVICE_ROLE_KEY="eyJh...tu_service_role_key..."

# Credenciales de inicialización (Seed del SuperUsuario)
SUPERUSER_EMAIL="admin@tu-app.com"
SUPERUSER_PASSWORD="AdminPassword123!"

# Configuración de entorno
SHOW_SWAGGER="true" # true o false, ideal false en prod

# Contraseña para el dashboard de logs en SEQ
SEQ_ADMIN_PASSWORD="MySeqSuperSecretPassword!"

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS EN EL CLÚSTER (Opcional)
# ------------------------------------------------------------------------------
# Si el pipeline también va a desplegar y configurar PostgreSQL dentro del
# mismo clúster K3s (usando k8s/postgres.yaml), se necesitan descomentar y usar:
# 
# POSTGRES_DB="uvoluntapp_db"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="local_secret_password"
